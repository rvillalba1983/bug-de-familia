    "contestador_start": {
      "speaker": "contestador",
      "text": "Ha llamado usted a la centralita. No hay nadie. Identificado como: {mote}. Tiene... tres... mensajes antiguos. Pulse lo que quiera, me da igual.",
      "options": [
        {
          "text": "Mensaje 1",
          "next": "c_m1",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Mensaje 2",
          "next": "c_m2",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Mensaje 3",
          "next": "c_m3",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Meter la bobina que falta.",
          "next": "c_m4",
