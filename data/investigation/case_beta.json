  "dialogue": {
    "paca_start": {
      "speaker": "paca",
      "text": "¡Esos hongos han hecho abono a Manolo Cojinete! ¿Tú qué quieres, joven?",
      "options": [
        {
          "text": "¿Qué le pasó a Manolo?",
          "next": "paca_story",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "He encontrado a Manolo. Está apagado y su reloj marca las 21:00.",
          "next": "paca_truth",
          "requires": [
            "e_manolo"
          ],
          "forbids": [
            "paz",
            "tregua",
            "guerra"
          ],
          "sets": []
        },
        {
          "text": "Los hongos te devuelven el sombrero a cambio de fertilizante.",
          "next": "paca_tregua",
          "requires": [
            "oferta_seta"
          ],
          "forbids": [
            "paz",
            "tregua",
            "guerra"
          ],
          "sets": [
            "tregua"
          ]
        },
        {
          "text": "Sí, lo vi: los hongos lo desguazaron.",
          "next": "paca_guerra",
          "requires": [
            "oido_paca"
          ],
          "forbids": [
            "paz",
            "tregua",
            "guerra"
          ],
          "sets": [
            "guerra"
          ]
        },
        {
          "text": "Necesito cruzar la tierra de nadie.",
          "next": "paca_pase",
          "requires": [],
          "forbids": [
            "salvoconducto"
          ],
          "sets": []
        },
        {
          "text": "Nada, adiós.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "¿Has oído algún rumor?",
          "next": "rumor_extra",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "paca_story": {
      "speaker": "paca",
      "text": "Salió anoche y no ha vuelto. Y los hongos reciclan robots muertos. Saca tus cuentas.",
      "options": [
        {
          "text": "Lo investigaré.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": [
            "oido_paca"
          ]
        }
      ]
    },
    "paca_truth": {
      "speaker": "paca",
      "text": "¿Apagado? A las 21:00, claro. Pero eso no quita que los hongos le quitaran el sombrero.",
      "options": [
        {
          "text": "Votaron no desguazarlo. Aquí está el acta.",
          "next": "paca_conv",
          "requires": [
            "e_acta"
          ],
          "forbids": [],
          "sets": [
            "paca_convencida"
          ]
        },
        {
          "text": "Ya volveré.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "paca_conv": {
      "speaker": "paca",
      "text": "Mil doscientos votos en contra... Eso es más de lo que votan para respirar. Está bien, habla con ellos.",
      "options": [
        {
          "text": "Hablaré con ellos.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "paca_tregua": {
      "speaker": "paca",
      "text": "¿Fertilizante? Qué vergüenza. Trato hecho.",
      "options": [
        {
          "text": "Adiós.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "paca_guerra": {
      "speaker": "paca",
      "text": "¡Lo sabía! ¡Eusebio, saca las minas de petanca!",
      "options": [
        {
          "text": "Uy.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "eusebio_start": {
      "speaker": "eusebio",
      "text": "Manolo tenía la manía de salir a mirar el atardecer. Por el norte. Yo no digo nada.",
      "options": [
        {
          "text": "¿Dónde anda Don Ramón?",
          "next": "eusebio_ramon",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "¿Quién es «la abuela»?",
          "next": "eusebio_abuela",
          "requires": [
            "e_placa"
          ],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Gracias.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": [
            "pista_norte"
          ]
        }
      ]
    },
    "seta_start": {
      "speaker": "seta",
      "text": "¿Vienes a votar? Tenemos una moción sobre si respirar.",
      "options": [
        {
          "text": "¿Sabéis algo de un tal Manolo?",
          "next": "seta_manolo",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Ese sombrero que tenéis es de un Jubilado.",
          "next": "seta_sombrero",
          "requires": [
            "e_sombrero"
          ],
          "forbids": [
            "paz",
            "tregua",
            "guerra"
          ],
          "sets": []
        },
        {
          "text": "Manolo se apagó solo, y Paca ya lo sabe. Devolved el sombrero.",
          "next": "seta_paz",
          "requires": [
            "e_manolo",
            "paca_convencida"
          ],
          "forbids": [
            "paz",
            "tregua",
            "guerra"
          ],
          "sets": [
            "paz"
          ]
        },
        {
          "text": "Los Jubilados vienen a por vosotros.",
          "next": "seta_guerra",
          "requires": [
            "oido_paca"
          ],
          "forbids": [
            "paz",
            "tregua",
            "guerra"
          ],
          "sets": [
            "guerra"
          ]
        },
        {
          "text": "Necesito cruzar la tierra de nadie.",
          "next": "seta_pase",
          "requires": [],
          "forbids": [
            "salvoconducto"
          ],
          "sets": []
        },
        {
          "text": "Esa bobina no es chatarra, es correo. Lo pone en la etiqueta y en vuestra propia acta.",
          "next": "seta_voto",
          "requires": [
            "e_etiqueta",
            "e_acta"
          ],
          "forbids": [
            "voto_bobina",
            "guerra"
          ],
          "sets": [
            "voto_bobina"
          ]
        },
        {
          "text": "Otro día.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "seta_manolo": {
      "speaker": "seta",
      "text": "Votamos no desguazar a nadie. Está en el acta, por ahí, entre el compost.",
      "options": [
        {
          "text": "Gracias.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "seta_sombrero": {
      "speaker": "seta",
      "text": "Apareció solo. Votamos quedárnoslo. Por un poco de fertilizante podríamos volver a votar.",
      "options": [
        {
          "text": "Se lo diré a los Jubilados.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": [
            "oferta_seta"
          ]
        }
      ]
    },
    "seta_paz": {
      "speaker": "seta",
      "text": "Moción aprobada a la tercera: devolvemos el sombrero y pedimos perdón por si acaso.",
      "options": [
        {
          "text": "Adiós.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "seta_guerra": {
      "speaker": "seta",
      "text": "Moción de guerra. Primera votación: sí. Vuelve dentro de tres votaciones para verlo.",
      "options": [
        {
          "text": "Uy.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "anselmo_start": {
      "speaker": "anselmo",
      "text": "Yo voto lo que vote ella. Ella vota lo que vote yo. Funciona fatal.",
      "options": [
        {
          "text": "Ya veo.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "paca_pase": {
      "speaker": "paca",
      "text": "Un salvoconducto cuesta, joven. Una pieza buena o algo que sepas de esos hongos.",
      "options": [
        {
          "text": "Toma este repuesto.",
          "next": "paca_pase_ok",
          "requires": [],
          "forbids": [],
          "sets": [
            "salvoconducto"
          ],
          "cost_piece": true
        },
        {
          "text": "Votaron no desguazar a Manolo. Te lo enseño.",
          "next": "paca_pase_ok",
          "requires": [
            "e_acta"
          ],
          "forbids": [],
          "sets": [
            "salvoconducto"
          ]
        },
        {
          "text": "Lo pensaré.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "paca_pase_ok": {
      "speaker": "paca",
      "text": "Di que vas de mi parte. Las minas no saben leer, ojo.",
      "options": [
        {
          "text": "Gracias.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "eusebio_ramon": {
      "speaker": "eusebio",
      "text": "Hace su ronda: bosque del norte, baja por el oeste y sigue por el sur. Si algo se rompe, aparece. Es lo único que le alegra.",
      "options": [
        {
          "text": "Gracias.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "eusebio_abuela": {
      "speaker": "eusebio",
      "text": "Abuela somos todos aquí, joven. Y todos nos apagamos a la misma hora, ya sabes cuál.",
      "options": [
        {
          "text": "Ya.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "seta_pase": {
      "speaker": "seta",
      "text": "Se somete a votación. Cuota: un repuesto.",
      "options": [
        {
          "text": "Toma.",
          "next": "seta_pase_ok",
          "requires": [],
          "forbids": [],
          "sets": [
            "salvoconducto"
          ],
          "cost_piece": true
        },
        {
          "text": "Paso.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "seta_pase_ok": {
      "speaker": "seta",
      "text": "Aprobado por 1.204 esporas. No pises lo que parece una bola.",
      "options": [
        {
          "text": "Gracias.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "seta_voto": {
      "speaker": "seta",
      "text": "Moción aprobada. Se abstiene un champiñón. Llévate tu correo.",
      "options": [
        {
          "text": "Gracias.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
