    "c_m1": {
      "speaker": "contestador",
      "text": "«...ya respira. ¿Quién firma el parte? Yo no, que a mí me pilla el martes.»",
      "options": [
        {
          "text": "Otro mensaje.",
          "next": "contestador_start",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Colgar.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "c_m2": {
      "speaker": "contestador",
      "text": "«Yo puse la mitad de la mente, y ni siquiera era mi mitad buena.» Se oye un ladrido. «Eso, díselo tú.»",
      "options": [
        {
          "text": "Otro mensaje.",
          "next": "contestador_start",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Colgar.",
          "next": "",
          "requires": [],
          "forbids": [],
          "sets": []
        }
      ]
    },
    "c_m3": {
      "speaker": "contestador",
      "text": "«Si sale mal, decimos que era de... krrrk... nadie, que no es... krrrk...» Fin del mensaje.",
      "options": [
        {
          "text": "Otro mensaje.",
          "next": "contestador_start",
          "requires": [],
          "forbids": [],
          "sets": []
        },
        {
          "text": "Colgar.",
          "next": "",
